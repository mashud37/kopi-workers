# Config for kopi-editor. Copy to env.yaml (gitignored) or run
# `python manage.py install`. Any value can be overridden by an environment
# variable (KOPI_BACKEND, KOPI_LANG, ANTHROPIC_API_KEY, KOPI_ANTHROPIC_MODEL,
# KOPI_LLM_BASE_URL, KOPI_LLM_MODEL, KOPI_LLM_API_KEY, KOPI_PROJECT, KOPI_REGION,
# KOPI_SERVICE, KOPI_MODEL).

# --- which model the `edit` route uses ---
LANG: "british"          # british | american
BACKEND: "anthropic"     # anthropic | openai-compatible

# --- anthropic backend: Claude ---
# Paste your key during `manage.py settings`, or set the ANTHROPIC_API_KEY env var.
# No default model: choose one in `settings` (cost is yours to decide):
#   claude-haiku-4-5 (cheapest) | claude-sonnet-5-5 | claude-opus-5-5
ANTHROPIC_API_KEY: ""
ANTHROPIC_MODEL: ""

# --- openai-compatible backend: any server that accepts OpenAI's chat format ---
# A service (DeepSeek, Kimi, Qwen, OpenRouter), a server on this computer
# (Ollama http://localhost:11434/v1, LM Studio, vLLM), or your own Cloud Run
# service from `manage.py deploy` (its address plus /v1; the key is JOB_TOKEN).
LLM_BASE_URL: ""
LLM_MODEL: ""
LLM_API_KEY: ""

# --- your own Cloud Run service ---
# `python manage.py deploy` builds + deploys the vLLM/Qwen3 service on a Blackwell
# GPU and writes BASE_URL + JOB_TOKEN below. (Legacy L4 Ollama: `deploy --ollama`.)
PROJECT: ""
REGION: "europe-west4"
SERVICE: "kopi-editor-vllm"
MODEL: ""                   # deployed model, e.g. Qwen/Qwen3-32B-FP8, set by deploy
BASE_URL: ""                # written by `manage.py deploy`
JOB_TOKEN: ""               # written by `manage.py deploy`
# Deployed instance shape, only used to estimate run cost. The deploy scripts
# write these; defaults match the Blackwell vLLM service. (Legacy L4: nvidia-l4 / 4 / 16.)
GPU_TYPE: "nvidia-rtx-pro-6000"   # nvidia-rtx-pro-6000 | nvidia-l4
CPU: 20
MEMORY: 80
