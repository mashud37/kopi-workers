# Config for kopi-editor. Copy to env.yaml (gitignored) or run
# `python manage.py install`. Any value can be overridden by an environment
# variable (KOPI_PROJECT, KOPI_REGION, KOPI_SERVICE, KOPI_MODEL, KOPI_LANG,
# KOPI_LLM, ANTHROPIC_API_KEY, KOPI_ANTHROPIC_MODEL).

# --- which LLM backend the `edit` route uses ---
LANG: "british"   # british | american
LLM: "cloud"      # cloud | local | api | skip

# --- cloud backend: self-hosted GPU service ---
# `python manage.py deploy` builds + deploys a warm L4-GPU Cloud Run service and
# writes BASE_URL + JOB_TOKEN below.
PROJECT: ""
REGION: "europe-west1"
SERVICE: "kopi-editor"
MODEL: ""                   # self-hosted model, e.g. qwen2.5:7b — choose in `settings`
BASE_URL: ""                # written by `manage.py deploy`
JOB_TOKEN: ""               # written by `manage.py deploy`

# --- api backend: Anthropic Claude (no GPU, no cold start) ---
# Paste your key during `manage.py settings`, or set the ANTHROPIC_API_KEY env var.
# No default model — choose one in `settings` (cost is yours to decide):
#   claude-haiku-4-5 (cheapest) | claude-sonnet-4-6 | claude-opus-4-8
ANTHROPIC_API_KEY: ""
ANTHROPIC_MODEL: ""
