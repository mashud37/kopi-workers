# Upload filter for `gcloud builds submit`. Without this file gcloud falls back to
# .gitignore, which excludes adapter/* — so the staged QLoRA adapter never reaches
# Cloud Build and the image bakes an empty /adapter (served base-only). This file
# mirrors .gitignore EXCEPT it lets adapter/ through, since Dockerfile.vllm must bake
# it as the 'kopi' LoRA module. Secrets are still excluded explicitly.
.git/
.gitignore
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/
.kopi/

# Manuscripts / generated artefacts — large and irrelevant to the image.
input/*
output/*

# Secrets — never upload to Cloud Build.
env.yaml
env.vllm.yaml
env.ollama.yaml
.env

.DS_Store
